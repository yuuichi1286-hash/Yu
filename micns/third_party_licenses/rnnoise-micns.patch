+
+/* MicNS: return a state to its freshly created condition without
+   touching the allocator (usable while a capture stream restarts). */
+void rnnoise_reset(DenoiseState *st) {
+  RNNState rnn = st->rnn;
+  memset(st, 0, sizeof(*st));
+  st->rnn = rnn;
+  RNN_CLEAR(st->rnn.vad_gru_state, st->rnn.model->vad_gru_size);
+  RNN_CLEAR(st->rnn.noise_gru_state, st->rnn.model->noise_gru_size);
+  RNN_CLEAR(st->rnn.denoise_gru_state, st->rnn.model->denoise_gru_size);
+}
